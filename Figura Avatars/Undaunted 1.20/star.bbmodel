-fc3d-6560882d8f99","time":0,"color":-1,"interpolation":"linear"},{"channel":"timeline","data_points":[{"script":"host:sendChatMessage(\"!\")\nif player:isLoaded() and EMPOWERED then sounds:playSound(\"hexcasting:casting.thoth\", player:getPos(), 0.5, 1.15) end\n\n"}],"uuid":"c7de078d-3048-0bd7-5346-14bde223ffd5","time":0.08333,"color":-1,"interpolation":"linear"}]}}},{"uuid":"be233159-3804-18d2-bf64-1b6b4c899b87","name":"shieldstart","loop":"once","override":false,"length":0.125,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"c63ded31-ecf7-eb1e-8acc-40a4c0a9b41b":{"name":"primaryR","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"94240358-6087-d8ea-7c4d-ad6a5fbf2aed","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"-105.000000375","y":"29.999999438","z":"29.999999813"}],"uuid":"713c574a-784c-116f-a812-9f0fd2b6c63f","time":0.125,"color":-1,"interpolation":"catmullrom"}]},"801da7b0-a587-98d1-b2fa-5a692b7c7207":{"name":"secondaryR","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"7f892aa9-1fde-153a-cc60-3249557387c2","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"-75","y":"0","z":"-15"}],"uuid":"2ebde8fe-b76f-49a4-d054-03bad5bb4b1c","time":0.125,"color":-1,"interpolation":"catmullrom"}]},"2c744447-ddfc-15e7-d9db-711fe4f1a45d":{"name":"tertiaryR","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"cd3f54d0-be31-0e06-e6b8-c453e53f8b28","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"30"}],"uuid":"ad4aa86b-c1bd-da3a-74f6-957ee08dcae0","time":0.125,"color":-1,"interpolation":"catmullrom"}]},"34523741-18b7-07cb-8a50-77eaefb964fe":{"name":"primaryL","type":"bone","keyframes":[{"channel":"rotation","data_points":[