lation":"linear"}]},"effects":{"name":"Effects","type":"effect","keyframes":[{"channel":"timeline","data_points":[{"script":"DISABLE_WASD = true\n \nif avatar:getRemainingParticles()>15 and player:isLoaded() then\n        local var = (world:getTime())*(2*math.pi)/100\n        particles:newParticle(\"hexcasting:conjure_particle 1\",  \n          player:getPos()+vec(math.sin(var)*1,0.1,math.cos(var)*1))\n          :setColor(1,1,1)\n        var = var/2\n        particles:newParticle(\"hexcasting:conjure_particle 1\",  \n          player:getPos()+vec(math.sin(var)*2,0.1,math.cos(var)*-2))\n          :setColor(1,1,1)\n    end"}],"uuid":"a527b294-36d7-034e-970b-f4be9d5b795d","time":0,"color":-1,"interpolation":"linear"}]}}},{"uuid":"5cce8a22-7ba7-9896-e529-bf6927351822","name":"meditateNoSeatEnd","loop":"once","override":false,"length":0.5,"snapping":24,"selected":false,"anim_time_update":"","blend_weight":"","start_delay":"","loop_delay":"","animators":{"fc703595-ff2a-4079-a584-0b12d3f72939":{"name":"root","type":"bone","keyframes":[{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"76e220ee-5856-cbf0-e9f1-70ec534ed93d","time":0.125,"color":-1,"interpolation":"catmullrom"},{"channel":"rotation","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"ebbce8eb-7fc5-61ca-1e1c-7b920a7edfd6","time":0.5,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"db0eb37a-e2ae-82f8-1b47-5f0dc7b5fcb7","time":0.125,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"-10","z":"0"}],"uuid":"b5ae9c9b-2f7c-773b-46f6-7398b0f739a7","time":0,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"0","z":"0"}],"uuid":"acf675c4-8d60-554c-ffc3-228bb6ef6dfe","time":0.41667,"color":-1,"interpolation":"catmullrom"},{"channel":"position","data_points":[{"x":"0","y":"3.69","z":"0"}],"uuid":"56586438-4093-b658-4332-1b3e0c971219","time":0.20833,"color":-1